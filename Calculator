<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-commerce Profit Calculator Pakistan</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f0f2f5; padding: 20px; display: flex; justify-content: center; }
        .calculator-card { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.15); width: 100%; max-width: 450px; }
        h2 { color: #2c3e50; text-align: center; margin-bottom: 25px; border-bottom: 3px solid #008060; padding-bottom: 10px; }
        .input-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: 600; color: #444; font-size: 14px; }
        input { width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 6px; box-sizing: border-box; font-size: 16px; outline: none; transition: 0.2s; }
        input:focus { border-color: #008060; }
        .result-box { margin-top: 25px; padding: 20px; border-radius: 8px; background-color: #f8f9fa; border: 1px solid #dee2e6; }
        .profit { color: #1b5e20; font-size: 26px; font-weight: bold; }
        .loss { color: #b71c1c; font-size: 26px; font-weight: bold; }
        .breakdown { font-size: 13px; color: #555; margin-top: 15px; line-height: 1.8; border-top: 1px solid #eee; padding-top: 10px; }
        .highlight { font-weight: bold; color: #333; }
    </style>
</head>
<body>

<div class="calculator-card">
    <h2>Profit Calculator</h2>
    
    <div class="input-group">
        <label>Selling Price (PKR)</label>
        <input type="number" id="sellingPrice" placeholder="0" oninput="calculate()">
    </div>

    <div class="input-group">
        <label>Product Cost (Khareed)</label>
        <input type="number" id="productCost" placeholder="0" oninput="calculate()">
    </div>

    <div class="input-group">
        <label>Delivery Charges (Courier)</label>
        <input type="number" id="shipping" placeholder="0" oninput="calculate()">
    </div>

    <div class="input-group">
        <label>Ads Cost (Per Order)</label>
        <input type="number" id="ads" placeholder="0" oninput="calculate()">
    </div>

    <div class="input-group">
        <label>Packaging & Other Costs</label>
        <input type="number" id="packaging" placeholder="0" oninput="calculate()">
    </div>

    <div class="result-box" id="resultBox">
        <div style="font-weight: bold; color: #666;">Net Profit per Sale:</div>
        <div id="profitDisplay" class="profit">Rs. 0</div>
        
        <div class="breakdown">
            • Shopify Fee (2%): <span id="shopFee" class="highlight">Rs. 0</span><br>
            • Tax (WHT ~2%): <span id="wht" class="highlight">Rs. 0</span><br>
            • Profit Margin: <span id="margin" class="highlight">0</span>%
        </div>
    </div>
</div>

<script>
    function calculate() {
        let price = parseFloat(document.getElementById('sellingPrice').value) || 0;
        let cost = parseFloat(document.getElementById('productCost').value) || 0;
        let ship = parseFloat(document.getElementById('shipping').value) || 0;
        let ads = parseFloat(document.getElementById('ads').value) || 0;
        let pack = parseFloat(document.getElementById('packaging').value) || 0;
        
        // Shopify Transaction Fee for Pakistan (COD)
        let shopifyFee = price * 0.02;
        
        // Withholding Tax for Non-Filer (Courier payout)
        let wht = price * 0.02;

        let totalExpenses = cost + ship + ads + pack + shopifyFee + wht;
        let netProfit = price - totalExpenses;
        let margin = price > 0 ? (netProfit / price) * 100 : 0;

        let display = document.getElementById('profitDisplay');
        display.innerText = "Rs. " + Math.round(netProfit);
        
        if(netProfit >= 0) {
            display.className = "profit";
        } else {
            display.className = "loss";
        }

        document.getElementById('shopFee').innerText = "Rs. " + Math.round(shopifyFee);
        document.getElementById('wht').innerText = "Rs. " + Math.round(wht);
        document.getElementById('margin').innerText = margin.toFixed(1);
    }
</script>

</body>
</html>
