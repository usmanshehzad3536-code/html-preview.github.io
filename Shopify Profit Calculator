<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopify Pakistan Profit Calculator</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; padding: 20px; display: flex; justify-content: center; }
        .calculator-card { background: white; padding: 30px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); width: 100%; max-width: 500px; }
        h2 { color: #008060; text-align: center; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        .input-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; color: #333; font-size: 14px; }
        input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; font-size: 16px; }
        .result-box { margin-top: 25px; padding: 20px; border-radius: 10px; background-color: #e3f2fd; border-left: 5px solid #2196f3; }
        .profit { color: #2e7d32; font-size: 24px; font-weight: bold; }
        .loss { color: #d32f2f; font-size: 24px; font-weight: bold; }
        .breakdown { font-size: 13px; color: #666; margin-top: 10px; line-height: 1.6; }
        button { width: 100%; padding: 12px; background-color: #008060; color: white; border: none; border-radius: 5px; font-size: 16px; cursor: pointer; transition: 0.3s; margin-top: 10px; }
        button:hover { background-color: #005e46; }
    </style>
</head>
<body>

<div class="calculator-card">
    <h2>HP M10 Profit Calc</h2>
    
    <div class="input-group">
        <label>Selling Price (PKR) - Jitne ka bechna hai</label>
        <input type="number" id="sellingPrice" value="1799" oninput="calculate()">
    </div>

    <div class="input-group">
        <label>Product Cost (PKR) - Wholesale rate</label>
        <input type="number" id="productCost" value="850" oninput="calculate()">
    </div>

    <div class="input-group">
        <label>Courier Charges (PKR) - Delivery fees</label>
        <input type="number" id="shipping" value="200" oninput="calculate()">
    </div>

    <div class="input-group">
        <label>Ads Cost Per Sale (PKR) - Marketing</label>
        <input type="number" id="ads" value="250" oninput="calculate()">
    </div>

    <button onclick="calculate()">Calculate Profit</button>

    <div class="result-box" id="resultBox">
        <div>Your Net Profit:</div>
        <div id="profitDisplay" class="profit">Rs. 0</div>
        
        <div class="breakdown">
            <b>Deductions:</b><br>
            • Shopify Transaction Fee (2%): <span id="shopFee">0</span><br>
            • Packaging/Flyer Cost: Rs. 20<br>
            • Estimated Withholding Tax (WHT): <span id="wht">0</span><br>
            • Margin: <span id="margin">0</span>%
        </div>
    </div>
</div>

<script>
    function calculate() {
        let price = parseFloat(document.getElementById('sellingPrice').value) || 0;
        let cost = parseFloat(document.getElementById('productCost').value) || 0;
        let ship = parseFloat(document.getElementById('shipping').value) || 0;
        let ads = parseFloat(document.getElementById('ads').value) || 0;
        
        // 1. Shopify Transaction Fee (Pakistan mein COD par 2% lagti hai)
        let shopifyFee = price * 0.02;
        
        // 2. Packaging (Average flyer cost)
        let packaging = 20;
        
        // 3. Withholding Tax (Approx 2% on payout for non-filers)
        let wht = price * 0.02;

        let totalExpenses = cost + ship + ads + shopifyFee + packaging + wht;
        let netProfit = price - totalExpenses;
        let margin = (netProfit / price) * 100;

        // Display results
        let display = document.getElementById('profitDisplay');
        display.innerText = "Rs. " + Math.round(netProfit);
        
        if(netProfit > 0) {
            display.className = "profit";
        } else {
            display.className = "loss";
        }

        document.getElementById('shopFee').innerText = "Rs. " + Math.round(shopifyFee);
        document.getElementById('wht').innerText = "Rs. " + Math.round(wht);
        document.getElementById('margin').innerText = margin.toFixed(1);
    }
    
    // Initial run
    calculate();
</script>

</body>
</html>
