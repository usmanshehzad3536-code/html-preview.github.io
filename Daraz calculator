<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Daraz Profit Calculator (Offline)</title>
  <style>
    :root{--blue:#0b6eff;--light:#f6fbff;--card:#ffffff;--muted:#666}
    *{box-sizing:border-box;font-family:Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial}
    body{margin:0;background:linear-gradient(180deg,var(--light),#fff);color:#122;}
    .wrap{max-width:1100px;margin:24px auto;padding:18px}
    header{display:flex;align-items:center;gap:12px;margin-bottom:14px}
    header h1{font-size:20px;margin:0;color:var(--blue)}
    .grid{display:flex;gap:18px;background:var(--card);border-radius:12px;padding:18px;box-shadow:0 6px 20px rgba(6,42,112,0.08)}
    .col{flex:1;min-width:260px}
    .left{border-right:1px solid rgba(10,20,60,0.04);padding-right:14px}
    .right{padding-left:14px}
    label{display:block;font-weight:600;margin-top:10px;margin-bottom:6px}
    .row{display:flex;gap:8px}
    input[type="number"], input[type="text"], select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eefc;background:#fff}
    .small{font-size:13px;color:var(--muted);margin-top:4px}
    .inline{display:flex;align-items:center;gap:8px}
    .info{width:20px;height:20;border-radius:50%;display:inline-grid;place-items:center;background:var(--blue);color:white;font-weight:700;font-size:12px;cursor:pointer}
    .btns{display:flex;gap:8px;margin-top:14px}
    button{padding:10px 14px;border-radius:8px;border:0;cursor:pointer;font-weight:600}
    .btn-calc{background:var(--blue);color:#fff}
    .btn-reset{background:#f0f6ff;color:var(--blue);border:1px solid rgba(11,110,255,0.12)}
    .btn-share{background:#e8f2ff;color:var(--blue)}
    .results{background:#f8fbff;padding:12px;border-radius:10px}
    .line{display:flex;justify-content:space-between;padding:8px 6px;border-bottom:1px dashed rgba(10,20,60,0.04)}
    .line:last-child{border-bottom:0}
    .total{font-weight:800;color:#09327a}
    .k{font-size:13px;color:var(--muted)}
    .note{font-size:13px;color:var(--muted);margin-top:10px}
    footer{margin-top:12px;font-size:13px;color:var(--muted)}
    .popover{position:fixed;z-index:9999;max-width:320px;background:#fff;border-radius:8px;padding:12px;box-shadow:0 8px 30px rgba(6,42,112,0.12);display:none}
    .popover p{margin:0;font-size:14px;color:#082046}
    @media (max-width:820px){
      .grid{flex-direction:column}
      .left{border-right:none;padding-right:0}
      .right{padding-left:0}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="24" rx="6" fill="var(--blue)"/><path d="M7 12h10M7 7h10M7 17h6" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <h1>Daraz Profit Calculator — Offline</h1>
    </header>

    <div class="grid">
      <div class="col left">
        <!-- Inputs -->
        <label>Purchasing price (PKR)</label>
        <input id="purchase" type="number" min="0" step="0.01" value="0">

        <label>Selling price (PKR)</label>
        <input id="selling" type="number" min="0" step="0.01" value="0">

        <label>Daraz commission % <span class="info" data-key="commission">i</span></label>
        <input id="commission" type="number" min="0" step="0.01" value="0">
        <div class="small">Commission percentage applied on selling price.</div>

        <label>Payment fee % <span class="info" data-key="payment">i</span></label>
        <input id="paymentFee" type="number" min="0" step="0.01"
